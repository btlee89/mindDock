    def _inject_css_on_load(self):
        """웹페이지 로드 완료 시 웹뷰 내부의 CSS 스타일을 주입"""
        view = self.stacked_widget.currentWidget()
        if not isinstance(view, QWebEngineView):
            return
            
        css_selectors = {
            "Gemini": "gemini-footer, textarea[placeholder*='메시지를 입력'], .input-container", 
            "Perplexity": "footer, [class*='footer'], [id*='footer'], div[data-testid='search-input-box'], form, [data-testid='pro-upgrade'], .pro-upgrade, .upgrade-banner, .subscription-banner, .premium-banner, div[class*='upgrade'], div[class*='pro'], div[class*='premium'], div[class*='banner'], [class*='banner'], [id*='banner'], .app-banner, .mobile-banner, .install-banner, .download-banner, div[class*='app'], div[class*='mobile'], div[class*='install'], div[class*='download'], [data-testid*='app'], [data-testid*='mobile'], [data-testid*='install'], [data-testid*='download'], button[class*='open'], button[class*='app'], .open-app, .open-in-app, [aria-label*='Open'], [aria-label*='App'], button:contains('Open in App'), a:contains('Open in App'), [class*='promo'], [class*='subscription'], [class*='trial'], [class*='offer'], div:contains('Pro'), div:contains('Upgrade'), div:contains('Subscribe')", 
            "Copilot": "#cib-serp-main .cib-serp-main-content-footer-wrapper", 
            "ChatGPT": "div[class*='text-xs'][class*='text-center']",
        }

        api_name = self.api_combo.currentText()
        selector = css_selectors.get(api_name)

        if selector:
            js_css_injection = f"""
            (function() {{
                var existingStyle = document.getElementById('chat-hub-style');
                if (existingStyle) {{ existingStyle.remove(); }}

                var style = document.createElement('style');
                style.id = 'chat-hub-style';
                style.textContent = '{selector} {{ display: none !important; }}';
                document.head.appendChild(style);
                
                var mainView = document.querySelector('.main-view, .chat-view, #cib-serp-main-content'); 
                if (mainView) {{
                    mainView.style.paddingBottom = '0px';
                }}
                
                // 동적으로 생성되는 요소들을 지속적으로 감시하고 숨김
                function hideElements() {{
                    var elementsToHide = document.querySelectorAll('{selector}');
                    for (var i = 0; i < elementsToHide.length; i++) {{
                        elementsToHide[i].style.display = 'none';
                    }}
                }}
                
                hideElements();
                setInterval(hideElements, 2000);
            }})();
            """
            view.page().runJavaScript(js_css_injection)
            
            # Perplexity의 경우 추가적으로 5초 후 재적용
            if api_name == "Perplexity":
                QTimer.singleShot(5000, lambda: view.page().runJavaScript(js_css_injection))


