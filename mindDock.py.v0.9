class DevNull:
    """표준 에러(stderr) 출력을 무시(Null)하기 위한 클래스"""
    def write(self, msg):
        pass
    def flush(self, *args, **kwargs): # flush도 무시하도록 수정
        pass

# 웹엔진 관련 경고 메시지 억제 (주석 해제하면 메시지 표시)
sys.stderr = DevNull()
sys.stdout = DevNull()  # stdout도 억제

