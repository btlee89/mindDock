        self.forward_button = QPushButton("") # 🌟 FIX: 텍스트 제거
        self.forward_button.setIcon(self.style().standardIcon(QStyle.StandardPixmap.SP_ArrowForward))
        self.forward_button.setToolTip("앞으로가기 (Alt+Right)")
